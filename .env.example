# PostgreSQL Configuration
POSTGRES_USER=unifiedrx_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=unifiedrx_db

# Backend Database Connection
# Use localhost if running FastAPI outside Docker:
# DATABASE_URL=postgresql+asyncpg://unifiedrx_user:your_secure_postgres_password_here@localhost:5432/unifiedrx_db
# Use db service name if running FastAPI inside Docker Compose:
DATABASE_URL=postgresql+asyncpg://unifiedrx_user:your_secure_postgres_password_here@db:5432/unifiedrx_db

# JWT Authentication Security
SECRET_KEY=generate_a_secure_random_64_character_hex_or_base64_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Initial Administrator Account Seed (provisioned via python -m app.scripts.seed_admin)
ADMIN_EMAIL=admin@unifiedrx.local
ADMIN_PASSWORD=ReplaceWithSecurePassword123!
ADMIN_FULL_NAME=System Administrator

# Clinical Intelligence Configuration
TEMPORAL_ASSOCIATION_WINDOW_DAYS=14
ENABLE_REAL_OCR_MODELS=true

# Phase 4 AI Clinical Summary (Ollama integration)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
