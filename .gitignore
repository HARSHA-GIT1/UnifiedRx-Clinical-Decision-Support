# ── Python & Bytecode ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual Environments ──────────────────────────────────────────
venv/
.venv/
env/
ENV/
backend/backend/
*/.venv/
*/venv/

# ── Environment & Secrets (NEVER COMMIT) ─────────────────────────
.env
.env.*
*.env
!.env.example

# ── IDEs & Editors ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Operating System Artifacts ────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ── Node & Frontend Builds ────────────────────────────────────────
node_modules/
*/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Uploads & Runtime Artifacts ───────────────────────────────────
# Preserve upload directory with .gitkeep but ignore uploaded files
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ── Databases & Backups ───────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump
*.sql
*.sql.gz

# ── Testing, Quality & Coverage ───────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Logs & Temporary Dumps ────────────────────────────────────────
*.log
logs/

# ── Scratch & Local Debug Scripts ─────────────────────────────────
backend/fix_alerts_pipeline.py
backend/verify.py
